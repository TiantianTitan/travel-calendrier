# Optional paired override. Without overrides, this dedicated app uses its shared trip database.
# Set BOTH values to use an isolated development/preview database.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: full public URL for canonical and share-card links. Vercel's production URL is used when omitted.
NEXT_PUBLIC_SITE_URL=
